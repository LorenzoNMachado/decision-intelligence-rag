# Copy to .env (never commit it; .env and .env.* are git-ignored) and export the variables,
# e.g. `set -a; source .env; set +a`. Credentials are read only from environment variables.
# Every value below is a placeholder. Nothing here is required for the offline demo,
# the test suite, CI, or configurations A and B.

# --- Embeddings ---------------------------------------------------------------
# "hashing" (default, offline, deterministic) or "openai-compatible".
DIRAG_EMBEDDING_BACKEND=hashing
# Remote embeddings send document chunks and query text to this endpoint.
# For openai-compatible embeddings:
# DIRAG_EMBEDDING_MODEL=<embedding-model-id>
# DIRAG_EMBEDDING_BASE_URL=https://api.example.com/v1
# DIRAG_EMBEDDING_API_KEY=<your-key>   # falls back to DIRAG_LLM_API_KEY

# --- LLM (Strategy 3, LLM generator, LLM judge) ---------------------------------
# The provider is selected by its endpoint: any server implementing the OpenAI
# /chat/completions API works (a hosted API, an API gateway, or a local server
# such as one exposing http://localhost:<port>/v1). All three of BASE_URL, MODEL
# and API_KEY are required; while any is missing, LLM features stay disabled and
# the commands that need them exit with an explanatory message.
# Chat requests include text for the selected stage (question, records, evidence,
# or evaluation answer). Keep credentials out of URLs/query strings; use API_KEY.
# DIRAG_LLM_BASE_URL=https://api.example.com/v1
# DIRAG_LLM_MODEL=<generator-model-id>
# DIRAG_JUDGE_MODEL=<judge-model-id>     # a different model family is recommended
# DIRAG_LLM_API_KEY=<your-key>

# Sampling and output format. Set temperature to "none" for models that reject it.
# DIRAG_LLM_TEMPERATURE=0
# DIRAG_LLM_SEED=2026
# DIRAG_LLM_RESPONSE_FORMAT=json_schema   # json_schema | json_object | none
# DIRAG_LLM_TIMEOUT_S=60

# Token prices in USD per 1M tokens, from your provider's price list. They are
# REQUIRED whenever DIRAG_BUDGET_USD is a number: before each request the client
# computes an upper bound of its cost from these prices and refuses to send the
# request if the bound does not fit in the remaining budget (fail closed).
# Unset prices are "unknown", not zero; set both to 0 explicitly for a free local server.
# DIRAG_PRICE_PROMPT_PER_MTOK=<prompt price>
# DIRAG_PRICE_COMPLETION_PER_MTOK=<completion price>

# Spending limit per process, in USD, enforced against the upper bounds above and
# then charged with the provider-reported cost (or usage x prices, or the bound).
# It is only as accurate as the configured prices: the provider's own billing is
# what you pay. "none" disables the limit explicitly; unknown costs are then
# recorded as unknown.
DIRAG_BUDGET_USD=1.0
