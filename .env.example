# Copy to .env (never commit it) and export the variables, e.g. `set -a; source .env; set +a`.
# Nothing here is required for the offline demo or for configurations A and B.

# --- Embeddings ---------------------------------------------------------------
# "hashing" (default, offline, deterministic) or "openai-compatible".
DIRAG_EMBEDDING_BACKEND=hashing
# For openai-compatible embeddings:
# DIRAG_EMBEDDING_MODEL=<embedding-model-id>
# DIRAG_EMBEDDING_BASE_URL=https://api.example.com/v1
# DIRAG_EMBEDDING_API_KEY=<your-key>   # falls back to DIRAG_LLM_API_KEY

# --- LLM (Strategy 3, LLM generator, LLM judge) ---------------------------------
# Any server implementing the OpenAI /chat/completions API.
# DIRAG_LLM_BASE_URL=https://api.example.com/v1
# DIRAG_LLM_MODEL=<generator-model-id>
# DIRAG_JUDGE_MODEL=<judge-model-id>     # a different model family is recommended
# DIRAG_LLM_API_KEY=<your-key>

# Sampling and output format. Set temperature to "none" for models that reject it.
# DIRAG_LLM_TEMPERATURE=0
# DIRAG_LLM_SEED=2026
# DIRAG_LLM_RESPONSE_FORMAT=json_schema   # json_schema | json_object | none
# DIRAG_LLM_TIMEOUT_S=60

# Cost accounting when the provider does not report cost (USD per 1M tokens).
# DIRAG_PRICE_PROMPT_PER_MTOK=0
# DIRAG_PRICE_COMPLETION_PER_MTOK=0

# Hard spending ceiling per process, in USD.
DIRAG_BUDGET_USD=1.0
